# Required: SSH connection to Hostinger
SSH_HOST=your-hostinger-server.com
SSH_PORT=22
SSH_USER=your-ssh-username

# Auth: use one of these
SSH_PASSWORD=your-ssh-password
# OR: base64-encoded private key (run: base64 -w 0 ~/.ssh/id_rsa)
SSH_PRIVATE_KEY=

# Security: restrict which base folder clients can watch
ALLOWED_BASE_PATH=/home/youruser/images

# Optional: lock down which frontend origin can connect
ALLOWED_ORIGIN=https://your-frontend-domain.com

# Optional tuning
POLL_INTERVAL_MS=2000
PORT=3001
